# Example server block for the PUBLIC web-tier Nginx.
# Put the static registration page in /var/www/html.
# Replace APP_PRIVATE_IP with the private IP or internal DNS name of the app server.
# Validate with: sudo nginx -t

server {
    listen 80;
    server_name _;

    root /var/www/html;
    index register.html index.html;

    # Serve static content (including the registration form) from the web tier.
    location / {
        try_files $uri $uri/ =404;
    }

    # Forward PHP requests to the private application tier.
    # The app-tier Nginx must be configured to execute PHP through PHP-FPM.
    location ~ \.php$ {
        proxy_pass http://APP_PRIVATE_IP;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
